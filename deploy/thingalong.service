[Unit]
Description=Think Along Next.js app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/thingalong
Environment=NODE_ENV=production
EnvironmentFile=-/home/opc/thingalong/.env
ExecStart=/usr/bin/npm run start -- --hostname 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
